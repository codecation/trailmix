<p><%= PromptMailer::PROMPT_TEXT %></p>

<p>Simply reply to this email with your entry.</p>

<% if @announcement.present? %>
  <%= @announcement.html_safe %>
<% end %>

<% if @entry %>
  <p>Remember this? On <%= I18n.l(@entry.date, format: :month_day_year) %> (<%= (distance_of_time_in_words(@date, @entry.date)) %> ago), you wrote the following:</p>

  <p>----------------------</p>

  <%= simple_format @entry.body %>

  <% if @entry.photo.url %>
    <%# Signed URL: S3 caps expiry at 7 days, so photos in older emails stop loading. %>
    <%= image_tag @entry.photo.url(expire_at: 6.days.from_now), width: 400 %>
  <% end %>
<% end %>
